{
  "name": "release-cover",
  "version": "2.2.0",
  "description": "No Smoking Recordings release cover generator",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint",
    "format": "prettier --write ."
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.3.4",
  "keywords": [
    "typescript"
  ],
  "author": "Lyubomir Todorov",
  "license": "CC-BY-ND-4.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^5.0.0",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "lefthook": "^2.1.12",
    "prettier": "3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vitest-canvas-mock": "^1.2.0"
  }
}
