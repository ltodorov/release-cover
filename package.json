{
  "name": "release-cover",
  "version": "3.0.0",
  "description": "No Smoking Recordings release cover generator",
  "private": true,
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "format": "oxfmt --check",
    "format:fix": "oxfmt --write"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.22.0+sha512.894940a3d9a57dfa6fd373990fb4e41e09c2f2d76d982ed1d75275d39267f988fb4e2d40900cbe9921c68d97c67aa1a1096d276633db248f7b34927ac9ddb7a4",
  "keywords": [
    "typescript"
  ],
  "author": "Lyubomir Todorov",
  "license": "CC-BY-ND-4.0",
  "devDependencies": {
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^30.1.3",
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "rollup-plugin-visualizer": "^7.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vitest-canvas-mock": "^1.2.0"
  }
}
